{
  "manifest_version": 3,
  "name": "Ryotunes Spotify player",
  "version": "1.0.0",
  "description": "Lets Ryotunes control Spotify's Web Player in Ryotunes' own browser profile, and sign in to YouTube and SoundCloud there.",
  "permissions": ["cookies", "system.display", "alarms", "scripting"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "http://127.0.0.1/*",
    "https://*.youtube.com/*",
    "https://*.soundcloud.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page.js", "player-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
